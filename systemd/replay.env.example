# /etc/replay/replay.env, shared by every writer. Each writer's own is /etc/replay/writer-<instance>.env, mode 600,
# holding only REPLAY_KEY=0x...
TEMPO_RPC=http://127.0.0.1:8545
NVNMCHAIN_EXPORT_DIR=/opt/mainnet-full-export
REPLAY_WRITERS=0x...,0x...
REPLAY_RAMP=2026-12-02:25000,2026-12-30:300000
# REPLAY_REGISTRIES=us-ca1 us-ca2   # ids or names for a part; unset means every registry
