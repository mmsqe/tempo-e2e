# /etc/replay/replay.env. The key is apart, in /etc/replay/writer-0.env, mode 600, holding only REPLAY_KEY=0x...
# systemd reads both: a line is NAME=value with no `export`, and a comment after a value stays in the value.
TEMPO_RPC=http://127.0.0.1:8545
NVNMCHAIN_EXPORT_DIR=/opt/mainnet-full-export
REPLAY_RAMP=2026-12-01:25000,2026-12-15:350000
# Transactions a block, a record each on mainnet, also after a stop: 2 stay under TIP-1067's 10M gas target.
REPLAY_PER_BLOCK=2
# Ids or names of the first registries, quoted, to stop after them; unset means every registry.
# REPLAY_REGISTRIES="us-ca1 us-ca10"
