# What the suite reads that no --flag or README section covers.

# Binaries, else on PATH.
# TEMPO_BIN=/path/to/tempo
# TEMPO_XTASK_BIN=/path/to/tempo-xtask
# ALLEGRO_BIN=/path/to/allegro
# ALLEGRO_XTASK_BIN=/path/to/allegro-xtask
# ANCHORING_BIN=/path/to/nvnmchain-anchoring

# A prebuilt dev genesis in place of the generated one, and the dev node's block time.
# TEMPO_GENESIS=/path/to/genesis.json
# TEMPO_BLOCK_TIME=1sec

# Funding on a network without a faucet: a key, else account 0 of a mnemonic.
# E2E_FUNDER_KEY=0x...
# MNEMONIC="test test test test test test test test test test test junk"
